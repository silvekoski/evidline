{
  "name": "@tpm/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "replay": "tsx src/cli/replay.ts",
    "golden": "tsx src/cli/golden.ts"
  },
  "dependencies": {
    "@tpm/schemas": "workspace:*",
    "@tpm/core": "workspace:*",
    "@tpm/adapters": "workspace:*",
    "@tpm/egress": "workspace:*",
    "hono": "^4.13.8",
    "@hono/node-server": "^1.19.17",
    "better-sqlite3": "^13.0.3",
    "zod": "^4.6.5",
    "@tpm/corpus": "workspace:*",
    "@tpm/connectors": "workspace:*",
    "sqlite-vec": "0.1.9"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13"
  }
}
